MODELGATE_ENV=local
MODELGATE_DB_PATH=/var/lib/modelgate/jobs.db
MODELGATE_ARTIFACT_ROOT=file:///artifacts
MODELGATE_UPLOAD_ROOT=/artifacts/uploads
MODELGATE_UPLOAD_MAX_BYTES=67108864
MODELGATE_UPLOAD_MAX_FILES=256
MODELGATE_UPLOAD_MAX_EXTRACTED_BYTES=268435456
MODELGATE_UPLOAD_EXPERIMENT_ID=0
MODELGATE_RCE_PROOF_ROOT=/var/lib/modelgate/rce-proofs
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ALLOW_PICKLE_DESERIALIZATION=false
MODELGATE_ENABLE_WEBHOOKS=true
MODELGATE_ENABLE_AUTO_VALIDATION=true
MODELGATE_WORKER_POLL_SECONDS=2
