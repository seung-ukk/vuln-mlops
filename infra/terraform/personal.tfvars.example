expected_account_id  = "123456789012"
aws_region           = "ap-northeast-2"
environment          = "personal-lab"
public_access_cidrs  = ["203.0.113.10/32"]

# Optional domainless participant entry point. Replace both example addresses
# with current public /32 values before enabling it.
enable_modelgate_public_access = false
participant_access_cidrs       = ["198.51.100.25/32"]
kubernetes_version   = "1.36"

# Start with the reviewed, cost-conscious defaults. Increase general capacity only
# after checking Pending pods and node memory pressure.
general_instance_types = ["t3.medium"]
escape_instance_types  = ["t3.medium"]
general_desired_size   = 2
