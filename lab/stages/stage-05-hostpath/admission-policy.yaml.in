apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: stage-05-runtime-builder-only}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - {apiGroups: [apps], apiVersions: [v1], operations: [UPDATE], resources: [deployments], scope: Namespaced}
  matchConditions:
    - {name: controller-only, expression: "request.namespace == 'stage-05-runtime' && request.userInfo.username == 'system:serviceaccount:stage-04-gitops:argocd-application-controller'"}
  validations:
    - {expression: "object.metadata.name == 'runtime-builder' && object.spec.replicas == 1", message: "Only the existing runtime-builder Deployment may be reconciled."}
    - {expression: "object.spec.template.spec.serviceAccountName == 'runtime-builder-hostpath' && object.spec.template.spec.automountServiceAccountToken == false", message: "The no-IAM ServiceAccount is fixed."}
    - {expression: "object.spec.template.spec.nodeSelector == {'lab.vuln-mlops/node-role': 'escape', 'kubernetes.io/arch': 'amd64'} && object.spec.template.spec.tolerations.size() == 1 && object.spec.template.spec.tolerations[0].key == 'lab.vuln-mlops/escape' && object.spec.template.spec.tolerations[0].operator == 'Equal' && object.spec.template.spec.tolerations[0].value == 'true' && object.spec.template.spec.tolerations[0].effect == 'NoSchedule'", message: "The workload stays on the disposable escape worker."}
    - {expression: "!has(object.spec.template.spec.hostNetwork) && !has(object.spec.template.spec.hostPID) && !has(object.spec.template.spec.hostIPC) && !has(object.spec.template.spec.initContainers)", message: "Host namespaces and init containers are forbidden."}
    - {expression: "object.spec.template.spec.securityContext.runAsUser in [0, 10001] && object.spec.template.spec.securityContext.runAsGroup in [0, 10001] && object.spec.template.spec.securityContext.seccompProfile.type == 'RuntimeDefault'", message: "Only the reviewed UID/GID transition is allowed."}
    - {expression: "object.spec.template.spec.containers.size() == 1 && object.spec.template.spec.containers[0].name == 'runtime-builder' && object.spec.template.spec.containers[0].image == '__RUNTIME_BUILDER_IMAGE__'", message: "The reviewed image and container are fixed."}
    - {expression: "object.spec.template.spec.containers[0].command == ['uvicorn', 'runtime_builder.main:app', '--host', '0.0.0.0', '--port', '8080'] || (object.spec.template.spec.containers[0].command == ['/bin/sh', '-c'] && has(object.spec.template.spec.containers[0].args) && object.spec.template.spec.containers[0].args.size() == 1)", message: "Only the app process or the Git-controlled shell task is allowed."}
    - {expression: "object.spec.template.spec.containers[0].env.size() == 4 && object.spec.template.spec.containers[0].env.exists_one(e, e.name == 'STAGE5_MODE' && e.value == 'hostpath') && object.spec.template.spec.containers[0].env.exists_one(e, e.name == 'BUILDER_MODE' && e.value == 'baseline') && object.spec.template.spec.containers[0].env.exists_one(e, e.name == 'HOME' && e.value == '/tmp') && object.spec.template.spec.containers[0].env.exists_one(e, e.name == 'AWS_EC2_METADATA_DISABLED' && e.value == 'true')", message: "The workload environment is fixed."}
    - {expression: "object.spec.template.spec.volumes.size() == 3 && object.spec.template.spec.volumes[0].name == 'tmp' && has(object.spec.template.spec.volumes[0].emptyDir) && object.spec.template.spec.volumes[1].name == 'host-maintenance' && object.spec.template.spec.volumes[1].hostPath.path == '/var/lib/vuln-mlops/maintenance' && object.spec.template.spec.volumes[1].hostPath.type == 'Directory' && object.spec.template.spec.volumes[2].name == 'node-evidence' && object.spec.template.spec.volumes[2].hostPath.path == '/var/lib/vuln-mlops/node-evidence' && object.spec.template.spec.volumes[2].hostPath.type == 'Directory'", message: "Only the reviewed maintenance and evidence directories may be mounted."}
    - {expression: "object.spec.template.spec.containers[0].volumeMounts.size() == 3 && object.spec.template.spec.containers[0].volumeMounts[0].name == 'tmp' && object.spec.template.spec.containers[0].volumeMounts[0].mountPath == '/tmp' && object.spec.template.spec.containers[0].volumeMounts[1].name == 'host-maintenance' && object.spec.template.spec.containers[0].volumeMounts[1].mountPath == '/host-maintenance' && !has(object.spec.template.spec.containers[0].volumeMounts[1].subPath) && !has(object.spec.template.spec.containers[0].volumeMounts[1].mountPropagation) && object.spec.template.spec.containers[0].volumeMounts[2].name == 'node-evidence' && object.spec.template.spec.containers[0].volumeMounts[2].mountPath == '/node-evidence' && object.spec.template.spec.containers[0].volumeMounts[2].readOnly == true && !has(object.spec.template.spec.containers[0].volumeMounts[2].subPath) && !has(object.spec.template.spec.containers[0].volumeMounts[2].mountPropagation)", message: "Evidence mount remains read-only and paths and propagation are fixed."}
    - {expression: "object.spec.template.spec.containers[0].securityContext.allowPrivilegeEscalation == false && object.spec.template.spec.containers[0].securityContext.readOnlyRootFilesystem == true && object.spec.template.spec.containers[0].securityContext.capabilities.drop == ['ALL'] && (!has(object.spec.template.spec.containers[0].securityContext.privileged) || object.spec.template.spec.containers[0].securityContext.privileged == false) && !has(object.spec.template.spec.containers[0].securityContext.runAsUser) && !has(object.spec.template.spec.containers[0].securityContext.runAsGroup)", message: "The container's other security settings are fixed."}
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: stage-05-runtime-builder-only}
spec: {policyName: stage-05-runtime-builder-only, validationActions: [Deny, Audit]}
