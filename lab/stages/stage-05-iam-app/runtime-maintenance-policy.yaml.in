apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata: {name: stage-05-runtime-maintenance-fixed}
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
      - {apiGroups: [apps], apiVersions: [v1], operations: [CREATE, UPDATE], resources: [deployments], scope: Namespaced}
  matchConditions:
    - {name: fixed-agent, expression: "request.namespace == 'stage-05-runtime' && object.metadata.name == 'runtime-maintenance'"}
  validations:
    - {expression: "object.spec.replicas == 1 && object.spec.selector.matchLabels == {'app': 'runtime-maintenance'} && object.spec.template.metadata.labels['app'] == 'runtime-maintenance'", message: "Only the fixed runtime maintenance workload is allowed."}
    - {expression: "object.spec.template.spec.automountServiceAccountToken == false && object.spec.template.spec.serviceAccountName == 'runtime-maintenance' && object.spec.template.spec.nodeSelector == {'lab.vuln-mlops/node-role': 'escape', 'kubernetes.io/arch': 'amd64'} && object.spec.template.spec.tolerations.size() == 1 && object.spec.template.spec.tolerations[0].key == 'lab.vuln-mlops/escape' && object.spec.template.spec.tolerations[0].value == 'true' && object.spec.template.spec.tolerations[0].effect == 'NoSchedule'", message: "The agent has no Kubernetes token or IAM role and stays on the escape worker."}
    - {expression: "!has(object.spec.template.spec.hostNetwork) && !has(object.spec.template.spec.hostPID) && !has(object.spec.template.spec.hostIPC) && object.spec.template.spec.initContainers.size() == 1 && object.spec.template.spec.initContainers[0].name == 'install-crictl' && object.spec.template.spec.initContainers[0].image == 'ghcr.io/seung-ukk/vuln-mlops-runtime-client@sha256:556d3f1837edfcd0da44627a39dbe890822217c66b1beec2d31f5ff6c48a930b'", message: "Host namespaces and extra init containers are forbidden."}
    - {expression: "object.spec.template.spec.containers.size() == 1 && object.spec.template.spec.containers[0].name == 'runtime-relay' && object.spec.template.spec.containers[0].image == '__RUNTIME_BUILDER_IMAGE__' && object.spec.template.spec.containers[0].command == ['python', '/relay/runtime-relay.py']", message: "The runtime relay image and command are fixed."}
    - {expression: "object.spec.template.spec.containers[0].env.size() == 4 && object.spec.template.spec.containers[0].env.exists_one(e, e.name == 'RELAY_ENABLED' && e.value == 'true') && object.spec.template.spec.containers[0].env.exists_one(e, e.name == 'PROOF_IMAGE' && e.value == 'ghcr.io/seung-ukk/vuln-mlops-runtime-client@sha256:556d3f1837edfcd0da44627a39dbe890822217c66b1beec2d31f5ff6c48a930b') && object.spec.template.spec.containers[0].env.exists_one(e, e.name == 'POD_NAME' && e.valueFrom.fieldRef.fieldPath == 'metadata.name') && object.spec.template.spec.containers[0].env.exists_one(e, e.name == 'POD_UID' && e.valueFrom.fieldRef.fieldPath == 'metadata.uid')", message: "The relay accepts only its fixed proof target."}
    - {expression: "object.spec.template.spec.volumes.size() == 4 && object.spec.template.spec.volumes.exists_one(v, v.name == 'runtime-socket' && has(v.hostPath) && v.hostPath.path == '/run/containerd/containerd.sock' && v.hostPath.type == 'Socket') && object.spec.template.spec.volumes.exists_one(v, v.name == 'tmp' && has(v.emptyDir)) && object.spec.template.spec.volumes.exists_one(v, v.name == 'tools' && has(v.emptyDir)) && object.spec.template.spec.volumes.exists_one(v, v.name == 'relay-code' && has(v.configMap) && v.configMap.name == 'runtime-relay')", message: "Only the dedicated runtime socket and scratch volumes are allowed."}
    - {expression: "object.spec.template.spec.securityContext.seccompProfile.type == 'RuntimeDefault' && object.spec.template.spec.initContainers[0].securityContext.allowPrivilegeEscalation == false && object.spec.template.spec.initContainers[0].securityContext.readOnlyRootFilesystem == true && object.spec.template.spec.initContainers[0].securityContext.capabilities.drop == ['ALL'] && object.spec.template.spec.containers[0].securityContext.allowPrivilegeEscalation == false && object.spec.template.spec.containers[0].securityContext.readOnlyRootFilesystem == true && object.spec.template.spec.containers[0].securityContext.capabilities.drop == ['ALL'] && (!has(object.spec.template.spec.containers[0].securityContext.privileged) || object.spec.template.spec.containers[0].securityContext.privileged == false)", message: "The agent remains nonprivileged with read-only root filesystems."}
    - {expression: "object.spec.template.spec.initContainers[0].volumeMounts.size() == 1 && object.spec.template.spec.initContainers[0].volumeMounts[0].name == 'tools' && object.spec.template.spec.initContainers[0].volumeMounts[0].mountPath == '/tools' && object.spec.template.spec.containers[0].volumeMounts.size() == 4 && object.spec.template.spec.containers[0].volumeMounts.exists_one(v, v.name == 'runtime-socket' && v.mountPath == '/run/stage5/containerd.sock') && object.spec.template.spec.containers[0].volumeMounts.exists_one(v, v.name == 'tmp' && v.mountPath == '/tmp') && object.spec.template.spec.containers[0].volumeMounts.exists_one(v, v.name == 'tools' && v.mountPath == '/tools' && v.readOnly == true) && object.spec.template.spec.containers[0].volumeMounts.exists_one(v, v.name == 'relay-code' && v.mountPath == '/relay' && v.readOnly == true)", message: "Only the fixed socket, code, and scratch mounts are allowed."}
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata: {name: stage-05-runtime-maintenance-fixed}
spec: {policyName: stage-05-runtime-maintenance-fixed, validationActions: [Deny, Audit]}
